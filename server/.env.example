PORT=4000
# MongoDB connection string.
#   local: mongodb://127.0.0.1:27017/<database-name>
#   Atlas: mongodb+srv://<username>:<password>@<cluster-host>/<database-name>
MONGO_URI=mongodb://127.0.0.1:27017/document_manager
# A long random string (e.g. `openssl rand -hex 32`). Never commit the real value.
JWT_SECRET=replace-with-a-long-random-string
# Allowed browser origin(s), comma-separated. Production: the exact frontend domain, no trailing slash.
CLIENT_URL=http://localhost:5173
# Hosts without a shell (e.g. Render free tier): set to true to create the demo users at startup.
# SEED_DEMO_USERS=true
